{
  "name": "whistler-rentals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env prod",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:dev": "wrangler d1 execute whistler-rentals-db-dev --remote --file=./schema.sql",
    "db:prod": "wrangler d1 execute whistler-rentals-db-prod --remote --file=./schema.sql",
    "db:local": "wrangler d1 execute whistler-rentals-db-dev --local --file=./schema.sql"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.119.0"
  }
}
