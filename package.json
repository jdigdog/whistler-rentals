{
  "name": "whistler-rentals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:prod": "wrangler deploy --env prod",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "migrate:dev": "wrangler d1 migrations apply whistler-rentals-db-dev --remote",
    "migrate:prod": "wrangler d1 migrations apply whistler-rentals-db-prod --remote --env prod",
    "migrate:local": "wrangler d1 migrations apply whistler-rentals-db-dev --local"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.119.0"
  }
}
